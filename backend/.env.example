# Copy to backend/.env.

# --- Runtime ---
# "production", or anything else for dev
ENV=

# --- Database ---
# postgresql://user:password@host:5432/dbname. The app derives the async
# (asyncpg) and sync (psycopg) drivers from it.
DATABASE_URL=

WEB_URL=http://localhost:3000

# --- Redis ---
# Task queue, locks and OAuth state. Keys are prefixed dev: or prod: from ENV.
REDIS_URL=redis://localhost:6379/0

# --- Mailbox ---
# Fernet key for the OAuth tokens in mailboxes.credentials. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# base64 of a Google "web" OAuth client JSON
GMAIL_CLIENT_SECRETS_B64=
# base64 of {"client_id": "...", "client_secret": "..."} for a Microsoft Entra app
MSFT_CLIENT_SECRETS_B64=

# --- Reply detection ---
# Public https URL of this API; Outlook sends notifications to <BACKEND_HOST>/webhooks/outlook
BACKEND_HOST=
# Gmail push topic: projects/<project>/topics/<topic>
GMAIL_PUBSUB_TOPIC=

# --- Worker ---
# Unique per worker process; its unfinished tasks are re-queued on restart
WORKER_ID=worker-1

# --- Clerk ---
# Frontend API URL (Clerk dashboard → API keys), e.g. https://your-app.clerk.accounts.dev
# Used as the token issuer and to fetch the signing keys
CLERK_FRONTEND_API=
# Signing secret of the webhook that points at <backend URL>/clerk_webhook
CLERK_WEBHOOK_SECRET=

# --- Company search ---
# A master key: Organization Search, Job Postings, People Search and People Enrichment
APOLLO_API_KEY=
OPENAI_API_KEY=
# Optional outreach fallbacks when Apollo finds fewer than 2 people
HUNTER_API_KEY=
TAVILY_API_KEY=

# OPENAI_FILTER_MODEL=gpt-5.6-luna
# Writes outreach emails, follow-ups and reply drafts, and classifies replies
# OPENAI_MODEL=gpt-5.6-luna
# USD per 1M tokens, to log each filter call's cost
# OPENAI_PRICE_INPUT_PER_MTOK=
# OPENAI_PRICE_OUTPUT_PER_MTOK=

# --- Tuning (defaults shown) ---
# In-process Clerk id → user id cache
# CLERK_CACHE_TTL_SECONDS=300
# CLERK_CACHE_MAX_ENTRIES=10000
# One-time credits a new user is granted on sign-up (they never reset)
# SIGNUP_CREDITS=50
# How long after its last run Auto-Hunt may run again
# AUTO_HUNT_EVERY_HOURS=24
# Default job posting window for company searches and Auto-Hunt
# JOB_POSTED_WITHIN_DAYS=30
# New searches (OpenAI calls) each user may start per minute
# COMPANY_SEARCHES_PER_MINUTE=10
# Résumé uploads each user may start per 24 h
# RESUME_UPLOADS_PER_DAY=10
# Companies each user may add to outreach per minute
# OUTREACH_ADDS_PER_MINUTE=20
# Most emails a mailbox sends per day, after warm-up
# DAILY_SEND_CAP=20

# --- Résumés (S3) ---
# Private bucket; résumés are stored under resumes/{user_id}/. The API uploads
# them itself, so the bucket needs no CORS rule. See README for the IAM policy.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Model that reads the résumé PDF (defaults to OPENAI_FILTER_MODEL)
# OPENAI_RESUME_MODEL=
